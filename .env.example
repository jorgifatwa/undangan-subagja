# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.

# Postgres for wishes, guests, the WhatsApp template and admin accounts (required on Vercel).
# Connecting Neon (or Supabase / Prisma Postgres) from Vercel → Storage sets DATABASE_URL / POSTGRES_URL automatically.
# Leave empty locally to store data as JSON files in data/.
DATABASE_URL=

# First admin account. With a database it is created automatically on the first request when no admin exists yet,
# or any time with `pnpm db:seed` (which also resets the password). Without a database it is the only account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Long random string used to sign admin sessions, e.g. the output of `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# Optional: public address used in link previews (WhatsApp/Instagram), e.g. a custom domain.
# On Vercel the production domain is used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=
